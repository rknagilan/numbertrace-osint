# NumberTrace OSINT configuration. Copy to `.env` and edit. NEVER commit `.env`.
# Everything is optional: with no keys the tool runs in offline/manual-link mode.

# Default region used when a number is written in national format (e.g. 0771234567).
NUMBERTRACE_DEFAULT_REGION=LK

# --- Live public web search (optional, requires internet + your own key) ---
# Brave Search API (documented, has a free tier): https://api-dashboard.search.brave.com/
NUMBERTRACE_BRAVE_API_KEY=

# Google Programmable Search JSON API (LEGACY: closed to new customers,
# Google says it stops working on 2027-01-01). Only for existing customers.
NUMBERTRACE_GOOGLE_CSE_KEY=
NUMBERTRACE_GOOGLE_CSE_CX=

# --- Limits (safe defaults) ---
NUMBERTRACE_MAX_VARIANTS=4
NUMBERTRACE_MAX_QUERIES=6
NUMBERTRACE_HTTP_TIMEOUT=8
NUMBERTRACE_PROVIDER_TIMEOUT=15
NUMBERTRACE_MAX_CONCURRENCY=2
NUMBERTRACE_API_RATE_LIMIT_PER_MINUTE=10

# Comma-separated domain filters for search (optional).
NUMBERTRACE_INCLUDE_DOMAINS=
NUMBERTRACE_EXCLUDE_DOMAINS=

# --- Community reputation dataset (optional local JSON file you maintain) ---
# Leave empty to disable. The bundled sample is SYNTHETIC and only used in demo mode.
NUMBERTRACE_COMMUNITY_DATASET=

# --- Privacy ---
# Local history is OFF by default. Set to 1 to keep masked entries on this computer.
NUMBERTRACE_HISTORY=0
